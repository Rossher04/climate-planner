# ===== Local (desarrollo) =====
SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Base de datos local. sqlite para desarrollo rapido; postgres si lo tienes.
DB_ENGINE=sqlite
DB_NAME=climate_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# APIs
OPENWEATHER_API_KEY=pega_aqui_tu_openweather_key
GOOGLE_MAPS_API_KEY=pega_aqui_tu_google_maps_key

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ===== Correo (recuperacion de contrasena) =====
# En local, sin estas variables, el correo se imprime en la consola de Django.
# Para enviar correos REALES con Gmail, define:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu_correo@gmail.com
# EMAIL_HOST_PASSWORD=contrasena_de_aplicacion_de_16_caracteres

# ===== Produccion (Render) - NO se ponen aqui, se configuran en el dashboard =====
# DEBUG=False
# DATABASE_URL=  (lo inyecta Render automaticamente desde la BD)
# RENDER_EXTERNAL_HOSTNAME=  (lo inyecta Render automaticamente)
